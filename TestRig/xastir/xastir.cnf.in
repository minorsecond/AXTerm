# Generated by entrypoint.sh — @KEY@ placeholders are substituted there.
#
# Xastir reads this with get_string()/get_int(), which scan the file for
# "KEY:value" and wrap once, so order does not matter. Anything omitted takes
# Xastir's own default, which is what we want for everything not listed.
STATION_CALLSIGN:@CALLSIGN@
STATION_LAT:@STATION_LAT@
STATION_LONG:@STATION_LONG@
STATION_GROUP:/
STATION_SYMBOL:-
STATION_COMMENTS:AXTerm rig oracle
STATION_TRANSMIT_AMB:0
# The APRS data-type identifier for our posits, stored as a CHARACTER
# (xa_config.c uses store_char/get_char and interface.c passes it straight
# into the position report). Writing "0" here does not mean "type zero" — it
# makes the DTI the literal character '0' and every posit malformed.
# '=' = position without timestamp, messaging capable, which is what a station
# that answers queries should be advertising.
STATION_MESSAGE_TYPE:=

# Transmit for real; this station exists to answer.
DISABLE_TRANSMIT:0
DISABLE_POSIT_TX:@DISABLE_POSIT_TX@
DISABLE_OBJECT_TX:0
POSIT_RATE:@POSIT_RATE@
SMART_BEACONING:0

# Answer queries and auto-reply to messages — the behaviour under test.
AUTO_MSG_REPLY:AXTerm rig oracle

# No maps: nothing ever looks at the display, and map loading is slow and
# wants files we do not ship.
MAPS_AUTO_MAPS:0
MAPS_LONG_LAT_GRID:0

# Interface 0: KISS over the pty socat bridges to the rig hub.
# 10 == DEVICE_SERIAL_KISS_TNC (src/interface.h).
DEVICE0_TYPE:10
DEVICE0_NAME:@KISS_PTY@
DEVICE0_INTERFACE_COMMENT:AXTerm rig channel
DEVICE0_ONSTARTUP:1
DEVICE0_TXMT:1
DEVICE0_RECONN:1
# 13 == B9600. This is the *termios* constant, not a baud number: Xastir
# passes it straight to cfsetispeed() (interface.c serial_init), and a raw
# 9600 fails EINVAL. The failure is silent — the error print is behind
# `debug_level & 2` — so the only symptom is "Error opening interface 0 Hard
# Fail". Set XASTIR_DEBUG=2 to see it.
DEVICE0_SPEED:13
DEVICE0_STYLE:0
DEVICE0_RELAY_DIGIPEAT:0
DEVICE0_IGATE_OPTION:0
DEVICE0_UNPROTO1:@UNPROTO1@
DEVICE0_UNPROTO2:
DEVICE0_UNPROTO3:
DEVICE0_UNPROTO_IGATE:
# Do NOT send KISS parameter frames at open: the hub is a broadcast medium and
# would put our TXDELAY/persistence bytes on the air as if they were traffic.
DEVICE0_TNC_INIT_KISSMODE:0
DEVICE0_TNC_UP_FILE:
DEVICE0_TNC_DOWN_FILE:
